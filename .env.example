# ---------------------------------------------------------------
# Prime Arch — configuration d'environnement
# Copier ce fichier en ".env" puis adapter les valeurs.
# Ne JAMAIS versionner le fichier .env.
# ---------------------------------------------------------------

APP_NAME="Prime Arch"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prime_arch
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_NAME=primearch_session
SESSION_LIFETIME=7200
